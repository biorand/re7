<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Biohazard.BioRand.RE7\Biohazard.BioRand.RE7.csproj" Aliases="global,BioRandRE7" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="_Data/**/*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="IntelOrca.Biohazard.REE" Version="1.5.3" />
    <PackageReference Include="SkiaSharp" Version="4.152.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.152.1" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.55.1-alpha.0.7" />
  </ItemGroup>

  <Target Name="GenerateKeyItemRouteGraphDiagram"
          DependsOnTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\..\.."
          Command="dotnet &quot;$(TargetPath)&quot; generate key_item_route_graph -f Binary --output-dir &quot;$(MSBuildProjectDirectory)\..\..\docs&quot;" />
  </Target>

</Project>
